---
import Icon from "@/components/ui/Icon.astro";
import { pricing } from "@/config/pricing";
import Price from "./Price.astro";
---

<ul class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
  {
    pricing.plans.map((plan, index) => (
      <li
        class:list={["reveal flex flex-col rounded-2xl p-6 sm:p-7", plan.featured ? "on-night" : "bg-surface shadow-[inset_0_0_0_1px_var(--line)]"]}
        style={`--i:${index}`}
      >
        <div class="flex items-center justify-between gap-4">
          <h2 class="text-xl font-medium tracking-tight">{plan.name}</h2>
          {plan.featured && <span class="rounded-md bg-mint px-2 py-0.5 text-xs font-semibold text-ink">Most popular</span>}
        </div>
        <p class="mt-2 min-h-12 text-[0.9375rem] text-muted">{plan.description}</p>
        <p class="mt-6 flex items-baseline gap-2">
          <Price plan={plan} class="text-5xl font-medium tracking-[-0.045em] tabular" />
          {plan.monthly !== null && (
            <span class="text-sm text-muted" data-billed>
              per month
            </span>
          )}
        </p>
        <a href={plan.cta.href} class:list={["btn mt-6 w-full", plan.featured ? "btn-mint" : index === 0 ? "btn-secondary" : "btn-primary"]}>
          {plan.cta.label}
        </a>
        <div class:list={["mt-7 border-t pt-6", plan.featured ? "border-night-line" : "border-line"]}>
          {plan.includes && <p class="mb-3 text-sm font-medium">{plan.includes}</p>}
          <ul class="grid gap-2.5 text-[0.9375rem]">
            {plan.highlights.map((item) => (
              <li class="flex gap-2.5">
                <Icon name="check" class:list={["mt-0.5 size-4.5", plan.featured ? "text-mint" : "text-green"]} stroke={2.25} />
                {item}
              </li>
            ))}
          </ul>
        </div>
      </li>
    ))
  }
</ul>
