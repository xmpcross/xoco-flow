---
import Icon from "@/components/ui/Icon.astro";

interface Props {
  id?: string;
  title: string;
  items: { q: string; a: string }[];
  class?: string;
}

const { id = "faq", title, items, class: className } = Astro.props;
---

<section id={id} class:list={["section", className]} aria-labelledby={`${id}-title`}>
  <div class="shell grid gap-10 lg:grid-cols-12">
    <div class="reveal lg:col-span-4">
      <h2 id={`${id}-title`} class="text-display-md">{title}</h2>
    </div>
    <div class="divide-y divide-line border-y border-line lg:col-span-7 lg:col-start-6">
      {
        items.map((item) => (
          <details class="faq group" name={id}>
            <summary class="flex cursor-pointer items-center justify-between gap-6 py-5 text-lg font-medium tracking-tight">
              {item.q}
              <span class="grid size-7 shrink-0 place-items-center rounded-md bg-surface shadow-[inset_0_0_0_1px_var(--line)] transition-colors group-open:bg-mint group-open:shadow-none">
                <Icon name="plus" class="faq-plus size-4" stroke={2} />
              </span>
            </summary>
            <p class="max-w-2xl pb-6 text-muted">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq summary {
    list-style: none;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq :global(.faq-plus) {
    transition: transform 0.3s var(--ease-out-expo);
  }

  .faq[open] :global(.faq-plus) {
    transform: rotate(45deg);
  }
</style>
