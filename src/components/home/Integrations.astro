---
import AppIcon from "@/components/ui/AppIcon.astro";
import Icon from "@/components/ui/Icon.astro";
import SectionHead from "@/components/ui/SectionHead.astro";
import { integrationsSection } from "@/config/home";
import { integration } from "@/config/integrations";

const { title, lead, icons, cta } = integrationsSection;
---

<section class="section" aria-labelledby="integrations-title">
  <div class="shell">
    <SectionHead id="integrations-title" title={title} lead={lead} align="center" />
    <ul class="mx-auto mt-12 grid max-w-5xl grid-cols-4 gap-3 sm:gap-4 lg:grid-cols-8">
      {
        icons.map((icon, index) => (
          <li class="reveal" style={`--i:${index % 8}`}>
            <a href={cta.href} class="app-tile group flex aspect-square flex-col items-center justify-center gap-2 rounded-2xl bg-surface shadow-[inset_0_0_0_1px_var(--line)] transition-shadow hover:shadow-[inset_0_0_0_1px_var(--line-strong),var(--shadow-card)]">
              <AppIcon name={icon} class="size-9 sm:size-12" bare />
              <span class="hidden text-xs font-medium text-muted sm:block">{integration(icon)?.name}</span>
              <span class="sr-only sm:hidden">{integration(icon)?.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-10 text-center">
      <a href={cta.href} class="btn btn-secondary">
        {cta.label}
        <Icon name="arrow-right" class="btn-arrow" stroke={2} />
      </a>
    </div>
  </div>
</section>
