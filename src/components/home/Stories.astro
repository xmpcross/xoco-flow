---
import { Image } from "astro:assets";
import CompanyLogo from "@/components/ui/CompanyLogo.astro";
import Icon from "@/components/ui/Icon.astro";
import { storyFor, type CompanyName } from "@/config/customers";
import { storiesSection } from "@/config/home";

interface Props {
  /** The story shown large, then up to three cards. */
  featured?: CompanyName;
  cards?: CompanyName[];
}

const { featured = "Tidewater", cards = ["Fernway", "Northbeam", "Halden"] } = Astro.props;
const lead = storyFor(featured);
const rest = cards.map(storyFor).filter((story) => story !== undefined);
---

<section id="customers" class="section pt-8!" aria-labelledby="stories-title">
  <div class="shell">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <h2 id="stories-title" class="reveal max-w-2xl text-display-lg">{storiesSection.title}</h2>
      <a href={storiesSection.cta.href} class="arrow-link reveal group">
        {storiesSection.cta.label}
        <Icon name="arrow-right" class="btn-arrow" stroke={2} />
      </a>
    </div>

    {
      lead && (
        <div class="reveal mt-12 grid overflow-hidden rounded-2xl bg-wash md:grid-cols-12">
          <div class="md:col-span-5 lg:col-span-4">
            <Image
              src={lead.photo}
              alt={`${lead.name}, ${lead.role} at ${lead.company}`}
              widths={[480, 720, 960]}
              sizes="(min-width: 64rem) 25rem, (min-width: 48rem) 40vw, 100vw"
              class="aspect-4/3 size-full object-cover object-top md:aspect-auto"
            />
          </div>
          <figure class="flex flex-col p-7 sm:p-10 md:col-span-7 lg:col-span-8 lg:p-14">
            <CompanyLogo name={lead.company} class="text-lg" />
            <blockquote class="mt-8 text-[clamp(1.35rem,1.1rem+0.9vw,2rem)] leading-snug font-medium tracking-[-0.025em]">
              <p>“{lead.quote}”</p>
            </blockquote>
            <figcaption class="mt-auto grid gap-6 pt-10 sm:grid-cols-2 sm:items-end">
              <span>
                <span class="block font-medium">{lead.name}</span>
                <span class="block text-muted">{lead.role}, {lead.company}</span>
              </span>
              <span class="sm:text-right">
                <span class="block text-display-md tabular">{lead.metric.value}</span>
                <span class="block text-sm text-muted">{lead.metric.label}</span>
              </span>
            </figcaption>
          </figure>
        </div>
      )
    }

    <ul class="mt-5 grid gap-5 md:grid-cols-3">
      {
        rest.map((story, index) => (
          <li class="card reveal flex flex-col p-7" style={`--i:${index}`}>
            <CompanyLogo name={story.company} class="text-[1.05rem]" />
            <p class="mt-10 text-display-md tabular">{story.metric.value}</p>
            <p class="mt-1 text-muted">{story.metric.label}</p>
            <p class="mt-6 border-t border-line pt-6 text-[0.9375rem]">{story.summary}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
