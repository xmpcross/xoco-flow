---
import { Image } from "astro:assets";
import AppWindow from "@/components/product/AppWindow.astro";
import Canvas from "@/components/product/Canvas.astro";
import AppIcon from "@/components/ui/AppIcon.astro";
import Icon from "@/components/ui/Icon.astro";
import Logomark from "@/components/ui/Logomark.astro";
import { hero } from "@/config/home";
import { siteConfig } from "@/config/site";

const { primary, secondary } = siteConfig.actions;
const { announcement } = siteConfig;
---

<section class="pt-12 pb-6 sm:pt-20" aria-labelledby="hero-title">
  <div class="shell text-center">
    {
      announcement.enabled && (
        <a
          href={announcement.href}
          class="rise group inline-flex max-w-full items-center gap-2.5 rounded-lg bg-surface py-1 pr-2.5 pl-1 text-sm shadow-[inset_0_0_0_1px_var(--line)] transition-shadow hover:shadow-[inset_0_0_0_1px_var(--line-strong)]"
        >
          <span class="rounded-md bg-mint px-2 py-0.5 text-xs font-semibold">{announcement.badge}</span>
          <span class="truncate font-medium">{announcement.text}</span>
          <Icon name="arrow-right" class="btn-arrow size-3.5 text-muted" stroke={2} />
        </a>
      )
    }

    <h1 id="hero-title" class="rise mx-auto mt-7 max-w-4xl text-display-xl" style="--i:1">{hero.title}</h1>
    <p class="rise mx-auto mt-6 max-w-2xl text-lead text-muted" style="--i:2">{hero.lead}</p>

    <div class="rise mt-9 flex flex-wrap justify-center gap-3" style="--i:3">
      <a href={primary.href} class="btn btn-primary btn-lg">
        {primary.label}
        <Icon name="arrow-right" class="btn-arrow" stroke={2} />
      </a>
      <a href={secondary.href} class="btn btn-secondary btn-lg">{secondary.label}</a>
    </div>

    <ul class="rise mt-6 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-muted" style="--i:4">
      {
        hero.notes.map((note) => (
          <li class="inline-flex items-center gap-1.5">
            <Icon name="check" class="size-4 text-green" stroke={2.25} />
            {note}
          </li>
        ))
      }
    </ul>
  </div>

  <div class="shell mt-14 sm:mt-16">
    <div class="stage rise relative isolate overflow-hidden rounded-3xl bg-wash" style="--i:5">
      <Image
        src={hero.photo}
        alt={hero.photoAlt}
        widths={[800, 1200, 1600, 2400]}
        sizes="(min-width: 80rem) 1216px, 100vw"
        quality={88}
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 -z-10 hidden size-full object-cover object-right lg:block"
      />

      <div class="p-3 sm:p-6 lg:w-[56%] lg:py-12 lg:pr-0 lg:pl-14">
        <AppWindow trail={["Workflows", "New customer onboarding"]} status="Live">
          <Canvas animate />
        </AppWindow>
      </div>

      <div class="approval absolute right-8 bottom-10 hidden w-[21rem] rounded-xl bg-surface p-4 text-left shadow-(--shadow-window) ring-1 ring-line lg:block" aria-hidden="true">
        <p class="flex items-center gap-1.5 text-xs text-muted">
          <AppIcon name="slack" class="size-3.5" bare />
          {hero.approval.channel}
        </p>
        <div class="mt-3 flex gap-3">
          <Logomark class="size-8" />
          <div class="min-w-0">
            <p class="flex items-center gap-1.5 text-sm">
              <span class="font-semibold">{siteConfig.name}</span>
              <span class="rounded bg-wash px-1 text-[0.625rem] font-semibold text-muted uppercase">App</span>
              <span class="text-xs text-muted">10:44</span>
            </p>
            <p class="mt-1 text-sm leading-snug">{hero.approval.text}</p>
            <div class="mt-3 flex gap-2">
              <span class="rounded-md bg-green px-2.5 py-1 text-xs font-semibold text-white">Approve</span>
              <span class="rounded-md px-2.5 py-1 text-xs font-semibold shadow-[inset_0_0_0_1px_var(--line-strong)]">View plan</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .approval {
      animation: approval-in 0.8s var(--ease-out-expo) 1.6s both;
    }
  }

  @keyframes approval-in {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }
</style>
