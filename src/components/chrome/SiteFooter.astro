---
import Icon from "@/components/ui/Icon.astro";
import Wordmark from "@/components/ui/Wordmark.astro";
import { footerNavigation, siteConfig } from "@/config/site";
import { socialIcon } from "@/lib/socials";

const { newsletter, status } = siteConfig;
const live = newsletter.enabled && newsletter.action !== "";
const year = new Date().getFullYear();
---

<footer class="on-night">
  <div class="shell grid gap-14 pt-20 pb-14 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-5">
      <a href="/" class="inline-flex" aria-label={`${siteConfig.name} home`} data-logo-menu-trigger>
        <Wordmark />
      </a>
      <p class="mt-8 max-w-sm text-xl leading-snug font-medium tracking-tight">{newsletter.title}</p>
      <p class="mt-2 max-w-sm text-night-muted">{newsletter.description}</p>
      <form
        class="mt-6 flex max-w-md gap-2"
        action={live ? newsletter.action : undefined}
        method={newsletter.method}
        aria-describedby={live ? undefined : "newsletter-note"}
      >
        <label for="footer-email" class="sr-only">Email address</label>
        <input
          id="footer-email"
          name={newsletter.emailFieldName}
          type="email"
          required
          autocomplete="email"
          placeholder="you@company.com"
          disabled={!live}
          class="h-11 min-w-0 flex-1 rounded-lg bg-night-raised px-3.5 text-night-ink ring-1 ring-night-line outline-none placeholder:text-night-muted focus:ring-mint disabled:cursor-not-allowed"
        />
        <button type="submit" class="btn btn-mint h-11 min-h-0 disabled:cursor-not-allowed disabled:opacity-50" disabled={!live}>Subscribe</button>
      </form>
      {
        !live && (
          <p id="newsletter-note" class="mt-3 text-sm text-night-muted">
            Sign-up is off in this preview. Connect a form endpoint in the site config to turn it on.
          </p>
        )
      }
    </div>

    <nav class="grid grid-cols-2 gap-10 sm:grid-cols-4 lg:col-span-7" aria-label="Footer">
      {
        footerNavigation.map((column) => (
          <div>
            <p class="text-sm text-night-muted">{column.title}</p>
            <ul class="mt-4 grid gap-2.5">
              {column.links.map((link) => (
                <li>
                  <a href={link.href} class="text-[0.9375rem] transition-colors hover:text-mint">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="shell">
    <div class="flex flex-col gap-5 border-t border-night-line py-6 text-sm text-night-muted sm:flex-row sm:items-center">
      <p>© {year} {siteConfig.name}. All rights reserved.</p>
      {
        status.label &&
          (status.href ? (
            <a href={status.href} class="inline-flex items-center gap-2 hover:text-night-ink">
              <span class="size-2 rounded-full bg-mint" aria-hidden="true" />
              {status.label}
            </a>
          ) : (
            <p class="inline-flex items-center gap-2">
              <span class="size-2 rounded-full bg-mint" aria-hidden="true" />
              {status.label}
            </p>
          ))
      }
      <ul class="flex items-center gap-1 sm:ml-auto">
        {
          siteConfig.socials.map((social) => (
            <li>
              <a href={social.href} class="grid size-9 place-items-center rounded-md transition-colors hover:bg-night-raised hover:text-night-ink" aria-label={social.label}>
                <Icon name={socialIcon(social.label)} class="size-4" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
