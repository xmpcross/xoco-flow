---
import { Image } from "astro:assets";
import FlowNode from "@/components/product/FlowNode.astro";
import CompanyLogo from "@/components/ui/CompanyLogo.astro";
import Icon from "@/components/ui/Icon.astro";
import Wordmark from "@/components/ui/Wordmark.astro";
import { stories } from "@/config/customers";
import { navigation, siteConfig, type MenuFeature } from "@/config/site";
import { formatDate, getPosts, postHref } from "@/lib/posts";

const latest = (await getPosts())[0];
const story = stories[0];
const { primary, secondary, signIn } = siteConfig.actions;
const path = Astro.url.pathname;

const isCurrent = (href: string) => !href.includes("#") && href !== "/" && path.startsWith(href);
const menus = navigation.map((item, index) => ({ ...item, id: `menu-${index}` }));
const featureOf = (item: (typeof menus)[number]): MenuFeature | undefined =>
  "columns" in item ? item.feature : undefined;
---

<header class="site-header fixed inset-x-0 top-0 z-50" data-header>
  <div class="header-bar relative z-20 bg-page">
    <div class="shell flex h-(--header-h) items-center gap-4">
      <a href="/" class="flex shrink-0" aria-label={`${siteConfig.name} home`} data-logo-menu-trigger>
        <Wordmark class="h-5.5" />
      </a>

      <nav class="ml-6 hidden lg:block" aria-label="Main">
        <ul class="flex items-center">
          {
            menus.map((item) => (
              <li>
                {"columns" in item ? (
                  <button type="button" class="nav-trigger" aria-expanded="false" aria-controls={item.id} data-menu-trigger={item.id}>
                    {item.label}
                    <Icon name="chevron-down" class="nav-chevron size-3.5" stroke={2} />
                  </button>
                ) : (
                  <a href={item.href} class="nav-trigger" aria-current={isCurrent(item.href) ? "page" : undefined}>
                    {item.label}
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="ml-auto flex items-center gap-1 sm:gap-2">
        <a href={signIn.href} class="hidden rounded-md px-3 py-2 text-[0.9375rem] font-medium whitespace-nowrap transition-colors hover:bg-wash md:inline-block">
          {signIn.label}
        </a>
        <a href={secondary.href} class="btn btn-secondary btn-sm hidden xl:inline-flex">{secondary.label}</a>
        <a href={primary.href} class="btn btn-primary btn-sm hidden sm:inline-flex">{primary.label}</a>
        <button
          type="button"
          class="-mr-2 grid size-11 place-items-center rounded-md transition-colors hover:bg-wash lg:hidden"
          aria-expanded="false"
          aria-controls="mobile-nav"
          aria-label="Open menu"
          data-mobile-toggle
        >
          <span class="grid" data-icon-open><Icon name="menu" class="size-5" /></span>
          <span class="hidden" data-icon-close><Icon name="x" class="size-5" /></span>
        </button>
      </div>
    </div>
  </div>

  {
    menus.map(
      (item) =>
        "columns" in item && (
          <div id={item.id} class="mega absolute inset-x-0 top-full z-10 hidden bg-surface lg:block" inert data-menu-panel>
            <div class="shell grid grid-cols-[1fr_1fr_22rem] gap-10 py-8">
              {item.columns.map((column, index) => (
                <div class="mega-col" style={`--i:${index}`}>
                  {column.title && <p class="px-3 text-[0.8125rem] font-medium text-muted">{column.title}</p>}
                  <ul class:list={["mt-3 grid", column.links.some((link) => link.description) ? "gap-1" : "gap-0"]}>
                    {column.links.map((link) =>
                      link.description ? (
                        <li>
                          <a href={link.href} class="mega-link group" data-menu-link>
                            {link.icon && (
                              <span class="mega-icon">
                                <Icon name={link.icon} class="size-[1.05rem]" stroke={1.9} />
                              </span>
                            )}
                            <span class="min-w-0">
                              <span class="block text-[0.9375rem] leading-snug font-medium">{link.label}</span>
                              <span class="mt-0.5 block text-[0.84375rem] leading-snug text-muted">{link.description}</span>
                            </span>
                          </a>
                        </li>
                      ) : (
                        <li>
                          <a href={link.href} class="mega-plain group" data-menu-link>
                            {link.label}
                            <Icon name="arrow-right" class="btn-arrow size-3.5 text-muted opacity-0 transition-opacity group-hover:opacity-100" stroke={2} />
                          </a>
                        </li>
                      ),
                    )}
                  </ul>
                </div>
              ))}

              <div class="mega-col" style="--i:2">
                {featureOf(item) === "product" && (
                  <a href="/#how-it-works" class="group flex h-full flex-col overflow-hidden rounded-xl bg-wash" data-menu-link>
                    <span class="dot-grid relative block px-6 pt-6 pb-5">
                      <span class="mx-auto grid max-w-60 justify-items-center">
                        <FlowNode app="hubspot" title="Deal closed" kind="Trigger" class="w-full" />
                        <span class="block h-4 w-[1.5px] bg-line-strong" />
                        <FlowNode icon="bot" tone="ink" title="Draft the plan" kind="Agent" class="w-full" />
                        <span class="block h-4 w-[1.5px] bg-line-strong" />
                        <FlowNode app="slack" title="Lead approves" kind="Approval" status="waiting" class="w-full" />
                      </span>
                    </span>
                    <span class="block border-t border-line bg-surface p-4">
                      <span class="block text-[0.9375rem] font-medium">See a workflow built from one sentence</span>
                      <span class="mt-1 inline-flex items-center gap-1.5 text-sm text-muted group-hover:text-ink">
                        How {siteConfig.name} works <Icon name="arrow-right" class="btn-arrow size-3.5" stroke={2} />
                      </span>
                    </span>
                  </a>
                )}
                {featureOf(item) === "story" && story && (
                  <a href="/customers/" class="group flex h-full flex-col rounded-xl bg-night p-6 text-night-ink" data-menu-link>
                    <CompanyLogo name={story.company} class="text-lg" />
                    <span class="mt-auto pt-10 text-5xl font-medium tracking-[-0.045em]">{story.metric.value}</span>
                    <span class="mt-2 text-sm text-night-muted">{story.metric.label}</span>
                    <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-mint">
                      Read customer stories <Icon name="arrow-right" class="btn-arrow size-3.5" stroke={2} />
                    </span>
                  </a>
                )}
                {featureOf(item) === "latest" && latest && (
                  <a href={postHref(latest)} class="group flex h-full flex-col overflow-hidden rounded-xl bg-wash" data-menu-link>
                    <span class="block aspect-video overflow-hidden">
                      <Image src={latest.data.cover} alt="" width={704} height={396} loading="eager" class="size-full object-cover transition-transform duration-700 group-hover:scale-[1.03]" />
                    </span>
                    <span class="block p-4">
                      <span class="meta block">Latest · {formatDate(latest.data.date)}</span>
                      <span class="mt-1 line-clamp-2 block text-[0.9375rem] leading-snug font-medium">{latest.data.title}</span>
                    </span>
                  </a>
                )}
              </div>
            </div>

            {item.footer && (
              <div class="border-t border-line bg-wash">
                <ul class="shell flex items-center gap-1 py-2.5">
                  {item.footer.map((link) => (
                    <li>
                      <a href={link.href} class="inline-flex items-center gap-2 rounded-md px-3 py-1.5 text-sm font-medium text-muted transition-colors hover:bg-surface hover:text-ink" data-menu-link>
                        {link.icon && <Icon name={link.icon} class="size-4" />}
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        ),
    )
  }

  <div id="mobile-nav" class="mobile-nav fixed inset-x-0 top-0 bottom-0 z-10 overflow-y-auto bg-page lg:hidden" inert data-mobile-nav>
    <nav class="shell flex min-h-full flex-col pt-[calc(var(--header-h)+0.5rem)] pb-8" aria-label="Mobile">
      <ul class="divide-y divide-line">
        {
          menus.map((item) => (
            <li>
              {"columns" in item ? (
                <details class="mobile-group" name="mobile-menu">
                  <summary class="flex items-center justify-between py-4 text-xl font-medium tracking-tight">
                    {item.label}
                    <Icon name="chevron-down" class="mobile-chevron size-5 text-muted" stroke={2} />
                  </summary>
                  <div class="grid gap-6 pb-6">
                    {item.columns.map((column) => (
                      <div>
                        {column.title && <p class="text-sm text-muted">{column.title}</p>}
                        <ul class="mt-2 grid gap-1">
                          {column.links.map((link) => (
                            <li>
                              <a href={link.href} class="flex items-center gap-3 py-1.5 text-[1.0625rem]" data-menu-link>
                                {link.icon && <Icon name={link.icon} class="size-4.5 text-muted" />}
                                {link.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </details>
              ) : (
                <a href={item.href} class="block py-4 text-xl font-medium tracking-tight" data-menu-link>
                  {item.label}
                </a>
              )}
            </li>
          ))
        }
      </ul>
      <div class="mt-auto grid gap-3 pt-10">
        <a href={primary.href} class="btn btn-primary w-full">{primary.label}</a>
        <a href={secondary.href} class="btn btn-secondary w-full">{secondary.label}</a>
        <a href={signIn.href} class="py-2 text-center font-medium text-muted">{signIn.label}</a>
      </div>
    </nav>
  </div>

  <div class="menu-scrim fixed inset-0 -z-10 bg-ink/20" data-menu-scrim></div>
</header>

<style>
  .site-header {
    transition: transform 0.45s var(--ease-out-expo);
  }

  .site-header[data-hidden] {
    transform: translateY(-110%);
  }

  .header-bar {
    box-shadow: 0 1px 0 transparent;
    transition: box-shadow 0.25s;
  }

  [data-scrolled] .header-bar,
  [data-menu-open] .header-bar {
    box-shadow: 0 1px 0 var(--line);
  }

  [data-mobile-open] .header-bar {
    box-shadow: none;
  }

  .nav-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.5rem 0.8rem;
    border-radius: 0.375rem;
    font-size: 0.9375rem;
    font-weight: 500;
    transition:
      color 0.2s,
      background-color 0.2s;
  }

  .nav-trigger:hover,
  .nav-trigger[aria-expanded="true"],
  .nav-trigger[aria-current="page"] {
    background: var(--wash);
  }

  .nav-chevron {
    color: var(--muted);
    transition: transform 0.3s var(--ease-out-expo);
  }

  .nav-trigger[aria-expanded="true"] .nav-chevron {
    transform: rotate(180deg);
  }

  /* Closed panels stay rendered (so they can fade) but are inert and click-through. */
  .mega {
    opacity: 0;
    pointer-events: none;
    transform: translateY(-0.4rem);
    box-shadow:
      0 1px 0 var(--line),
      0 24px 40px -24px rgb(6 34 38 / 0.25);
    transition:
      opacity 0.18s,
      transform 0.3s var(--ease-out-expo);
  }

  .mega[data-open] {
    opacity: 1;
    pointer-events: auto;
    transform: none;
    transition:
      opacity 0.2s,
      transform 0.35s var(--ease-out-expo);
  }

  .mega-col {
    opacity: 0;
    transform: translateY(-0.25rem);
    transition:
      opacity 0.25s,
      transform 0.4s var(--ease-out-expo);
  }

  .mega[data-open] .mega-col {
    opacity: 1;
    transform: none;
    transition-delay: calc(var(--i) * 35ms + 30ms);
  }

  .mega-link {
    display: flex;
    gap: 0.85rem;
    padding: 0.65rem 0.75rem;
    border-radius: 0.625rem;
    transition: background-color 0.15s;
  }

  .mega-link:hover,
  .mega-link:focus-visible {
    background: var(--wash);
  }

  .mega-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.5rem;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    transition:
      background-color 0.15s,
      color 0.15s,
      box-shadow 0.15s;
  }

  .mega-link:hover .mega-icon {
    background: var(--mint);
    box-shadow: inset 0 0 0 1px var(--mint-strong);
  }

  .mega-plain {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.55rem 0.75rem;
    border-radius: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
    transition: background-color 0.15s;
  }

  .mega-plain:hover {
    background: var(--wash);
  }

  .menu-scrim {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.25s,
      visibility 0s 0.25s;
  }

  [data-menu-open] .menu-scrim {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.25s;
  }

  .mobile-nav {
    overscroll-behavior: contain;
    scrollbar-width: none;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s;
  }

  [data-mobile-open] .mobile-nav {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-nav::-webkit-scrollbar {
    display: none;
  }

  .mobile-group summary {
    list-style: none;
    cursor: pointer;
  }

  .mobile-group summary::-webkit-details-marker {
    display: none;
  }

  .mobile-chevron {
    transition: transform 0.3s var(--ease-out-expo);
  }

  .mobile-group[open] .mobile-chevron {
    transform: rotate(180deg);
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");

  if (header) {
    const triggers = [...header.querySelectorAll<HTMLButtonElement>("[data-menu-trigger]")];
    const panels = [...header.querySelectorAll<HTMLElement>("[data-menu-panel]")];
    const scrim = header.querySelector<HTMLElement>("[data-menu-scrim]");
    const mobileToggle = header.querySelector<HTMLButtonElement>("[data-mobile-toggle]");
    const mobileNav = header.querySelector<HTMLElement>("[data-mobile-nav]");
    const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
    let current: string | null = null;
    let hoverTimer = 0;

    const setMenu = (id: string | null, focusFirst = false) => {
      current = id;
      triggers.forEach((trigger) => trigger.setAttribute("aria-expanded", String(trigger.dataset.menuTrigger === id)));
      panels.forEach((panel) => {
        panel.toggleAttribute("data-open", panel.id === id);
        panel.inert = panel.id !== id;
      });
      header.toggleAttribute("data-menu-open", id !== null);
      if (id && focusFirst) {
        document.getElementById(id)?.querySelector<HTMLElement>("a")?.focus();
      }
    };

    const closeMenu = (returnFocus = false) => {
      const trigger = triggers.find((item) => item.dataset.menuTrigger === current);
      setMenu(null);
      if (returnFocus) trigger?.focus();
    };

    triggers.forEach((trigger) => {
      const id = trigger.dataset.menuTrigger ?? null;
      trigger.addEventListener("click", () => setMenu(current === id ? null : id));
      trigger.addEventListener("keydown", (event) => {
        if (event.key === "ArrowDown") {
          event.preventDefault();
          setMenu(id, true);
        }
      });
      trigger.addEventListener("pointerenter", () => {
        if (!finePointer.matches) return;
        window.clearTimeout(hoverTimer);
        hoverTimer = window.setTimeout(() => setMenu(id), current ? 0 : 90);
      });
    });

    /* Leaving the bar or the open panel starts a short timer; the menu closes
       only if the pointer is in neither when it runs. */
    const bar = header.querySelector<HTMLElement>(".header-bar");
    const hoverZones = [bar, ...panels].filter((el): el is HTMLElement => el !== null);
    let pointer = { x: 0, y: 0 };
    document.addEventListener("pointermove", (event) => (pointer = { x: event.clientX, y: event.clientY }), {
      passive: true,
    });
    const scheduleClose = () => {
      if (!finePointer.matches || !current) return;
      window.clearTimeout(hoverTimer);
      hoverTimer = window.setTimeout(() => {
        const inside = hoverZones.some((zone) => {
          if (zone !== bar && zone.id !== current) return false;
          const box = zone.getBoundingClientRect();
          return pointer.x >= box.left && pointer.x <= box.right && pointer.y >= box.top && pointer.y <= box.bottom;
        });
        if (!inside) closeMenu();
      }, 220);
    };
    hoverZones.forEach((zone) => {
      zone.addEventListener("pointerleave", scheduleClose);
      zone.addEventListener("pointerenter", () => {
        if (current) window.clearTimeout(hoverTimer);
      });
    });

    bar?.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
      link.addEventListener("pointerenter", () => {
        if (!finePointer.matches || !current) return;
        window.clearTimeout(hoverTimer);
        hoverTimer = window.setTimeout(() => closeMenu(), 90);
      });
      link.addEventListener("focus", () => {
        if (current) closeMenu();
      });
    });

    scrim?.addEventListener("click", () => closeMenu());

    header.addEventListener("focusout", (event) => {
      const next = event.relatedTarget as Node | null;
      if (current && next && !header.contains(next)) closeMenu();
    });

    const setMobile = (open: boolean) => {
      header.toggleAttribute("data-mobile-open", open);
      if (mobileNav) mobileNav.inert = !open;
      mobileToggle?.setAttribute("aria-expanded", String(open));
      mobileToggle?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      mobileToggle?.querySelector("[data-icon-open]")?.classList.toggle("hidden", open);
      mobileToggle?.querySelector("[data-icon-close]")?.classList.toggle("hidden", !open);
      document.documentElement.style.overflow = open ? "hidden" : "";
    };

    mobileToggle?.addEventListener("click", () => setMobile(!header.hasAttribute("data-mobile-open")));

    header.querySelectorAll("[data-menu-link]").forEach((link) =>
      link.addEventListener("click", () => {
        closeMenu();
        setMobile(false);
      }),
    );

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      if (current) closeMenu(true);
      if (header.hasAttribute("data-mobile-open")) {
        setMobile(false);
        mobileToggle?.focus();
      }
    });

    window.matchMedia("(min-width: 64rem)").addEventListener("change", (event) => {
      if (event.matches) setMobile(false);
      else closeMenu();
    });

    /* Hide while scrolling down, return on any scroll up. Never hides near the
       top, or while a menu or the mobile sheet is open. */
    let lastY = window.scrollY;
    const onScroll = () => {
      const y = window.scrollY;
      const busy = current !== null || header.hasAttribute("data-mobile-open") || header.contains(document.activeElement);
      header.toggleAttribute("data-scrolled", y > 4);
      if (y < 160 || busy) header.removeAttribute("data-hidden");
      else if (Math.abs(y - lastY) > 6) header.toggleAttribute("data-hidden", y > lastY);
      lastY = y;
      document.documentElement.toggleAttribute("data-header-hidden", header.hasAttribute("data-hidden"));
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
    header.addEventListener("focusin", () => header.removeAttribute("data-hidden"));
  }
</script>
