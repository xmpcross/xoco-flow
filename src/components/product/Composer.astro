---
import AppIcon from "@/components/ui/AppIcon.astro";
import Icon from "@/components/ui/Icon.astro";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const prompt =
  "When a deal closes in HubSpot, draft an onboarding plan from the call notes. If the contract is over $50k, ask the account lead to approve it in Slack. Then open a project in Linear and send the welcome email.";
const apps = ["hubspot", "slack", "linear", "gmail"];
const suggestions = ["Route new leads by territory", "Chase invoices 7 days overdue", "Triage tickets by intent"];
---

<div class:list={["composer p-5 sm:p-6", className]}>
  <p class="text-[0.8125rem] font-medium text-muted">Describe the process</p>
  <div class="mt-3 rounded-xl bg-surface p-4 shadow-[0_0_0_1px_var(--line-strong),0_0_0_4px_var(--tide)]">
    <p class="text-[0.9375rem] leading-relaxed">
      {prompt}<span class="caret" aria-hidden="true"></span>
    </p>
    <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-line pt-3">
      <span class="flex items-center gap-2 text-[0.8125rem] text-muted">
        Uses
        <span class="flex -space-x-1">
          {apps.map((app) => <AppIcon name={app} class="size-6 ring-2 ring-surface" />)}
        </span>
      </span>
      <span class="inline-flex h-8 items-center gap-1.5 rounded-lg bg-ink px-3 text-[0.8125rem] font-medium text-white">
        <Icon name="wand-sparkles" class="size-3.5" stroke={2} /> Build workflow
      </span>
    </div>
  </div>
  <p class="mt-5 text-[0.8125rem] font-medium text-muted">Or start from</p>
  <ul class="mt-2.5 flex flex-wrap gap-2">
    {suggestions.map((item) => <li class="tag bg-surface">{item}</li>)}
  </ul>
</div>

<style>
  .caret {
    display: inline-block;
    width: 1.5px;
    height: 1.05em;
    margin-left: 2px;
    vertical-align: -0.15em;
    background: var(--ink);
  }

  @media (prefers-reduced-motion: no-preference) {
    .caret {
      animation: blink 1.1s steps(1) infinite;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
