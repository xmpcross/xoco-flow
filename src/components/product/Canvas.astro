---
import Icon from "@/components/ui/Icon.astro";
import FlowNode from "./FlowNode.astro";

interface Props {
  /** Plays the nodes in one by one on load. */
  animate?: boolean;
  class?: string;
}

const { animate = false, class: className } = Astro.props;
const tools = ["mouse-pointer-click", "plus", "bot", "git-branch"];
---

<div class:list={["canvas dot-grid relative px-4 py-6 sm:px-6 sm:py-7 lg:pl-16", animate && "canvas-animate", className]}>
  <div class="absolute top-1/2 left-3 hidden -translate-y-1/2 flex-col gap-1 rounded-xl bg-surface p-1 shadow-[0_0_0_1px_var(--line),0_1px_2px_rgb(6_34_38/0.05)] lg:flex" aria-hidden="true">
    {
      tools.map((tool, index) => (
        <span class:list={["grid size-8 place-items-center rounded-lg", index === 0 ? "bg-ink text-white" : "text-muted"]}>
          <Icon name={tool} class="size-4" stroke={1.9} />
        </span>
      ))
    }
  </div>

  <div class="graph mx-auto grid w-full max-w-[33rem] justify-items-center">
    <FlowNode kind="Trigger" app="hubspot" title="Deal moves to Closed won" sub="Pipeline: New business" status="done" class="node-main" style="--i:0" />
    <span class="wire" style="--i:1"></span>
    <FlowNode kind="Agent" icon="bot" tone="ink" title="Draft onboarding plan" sub="Reads the deal and call notes" status="done" class="node-main" style="--i:1" />
    <span class="wire" style="--i:2"></span>
    <div class="split grid w-full grid-cols-2 gap-3 sm:gap-4">
      <div class="branch">
        <span class="cond">Over $50k</span>
        <FlowNode kind="Approval" app="slack" title="Account lead approves" sub="Posts to #cs-handoffs" status="waiting" style="--i:2" />
      </div>
      <div class="branch">
        <span class="cond">Otherwise</span>
        <FlowNode kind="Action" app="gmail" title="Send welcome email" sub="From the account owner" status="done" style="--i:2" />
      </div>
    </div>
    <span class="wire" style="--i:3"></span>
    <FlowNode kind="Action" app="linear" title="Create onboarding project" sub="Template: Enterprise kickoff" class="node-main" style="--i:3" />
  </div>
</div>

<style>
  .canvas {
    container-type: inline-size;
    --wire: var(--line-strong);
    --gap: 1.5rem;
  }

  .canvas :global(.node-main) {
    width: min(100%, 17.5rem);
  }

  .wire {
    display: block;
    width: 1.5px;
    height: var(--gap);
    background: var(--wire);
  }

  .split {
    position: relative;
    padding-block: 2.25rem var(--gap);
  }

  .split::before,
  .split::after {
    content: "";
    position: absolute;
    left: 25%;
    right: 25%;
    height: 1.5px;
    background: var(--wire);
  }

  .split::before {
    top: 0;
  }

  .split::after {
    bottom: 0;
  }

  .branch {
    position: relative;
    display: grid;
    min-width: 0;
  }

  .branch::before,
  .branch::after {
    content: "";
    position: absolute;
    left: 50%;
    width: 1.5px;
    background: var(--wire);
  }

  .branch::before {
    top: -2.25rem;
    height: 2.25rem;
  }

  .branch::after {
    top: 100%;
    height: var(--gap);
  }

  .cond {
    position: absolute;
    z-index: 1;
    top: -1.125rem;
    left: 50%;
    transform: translate(-50%, -50%);
    padding: 0.1rem 0.45rem;
    border-radius: 0.375rem;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: 0.6875rem;
    font-weight: 500;
    white-space: nowrap;
    color: var(--muted);
  }

  @container (max-width: 26rem) {
    .canvas :global(.node-sub) {
      display: none;
    }

    .branch :global(.node-status) {
      display: none;
    }

    .branch :global(.flow-node) {
      gap: 0.5rem;
      padding-right: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .canvas-animate :global(.flow-node) {
      animation: node-in 0.7s var(--ease-out-expo) both;
      animation-delay: calc(var(--i) * 260ms + 350ms);
    }

    .canvas-animate :global(.node-status) {
      animation: status-in 0.4s var(--ease-out-expo) both;
      animation-delay: calc(var(--i) * 260ms + 800ms);
    }

    .canvas-animate .wire,
    .canvas-animate .split::before,
    .canvas-animate .branch::before {
      animation: wire-in 0.4s ease-out both;
      animation-delay: calc(var(--i, 2) * 260ms + 200ms);
    }

    .canvas-animate .wire {
      transform-origin: top;
    }
  }

  @keyframes node-in {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
  }

  @keyframes status-in {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
  }

  @keyframes wire-in {
    from {
      opacity: 0;
    }
  }
</style>
