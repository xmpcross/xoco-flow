---
import Closing from "@/components/home/Closing.astro";
import AppIcon from "@/components/ui/AppIcon.astro";
import Icon from "@/components/ui/Icon.astro";
import { integrationCategories, integrations, integrationsPage } from "@/config/integrations";
import BaseLayout from "@/layouts/BaseLayout.astro";

const { title, heading, lead, request } = integrationsPage;
const filters = ["All", ...integrationCategories];
---

<BaseLayout title={title} description={lead}>
  <section class="pt-14 pb-10 sm:pt-20" aria-labelledby="integrations-title">
    <div class="shell">
      <h1 id="integrations-title" class="rise max-w-3xl text-display-xl">{heading}</h1>
      <p class="rise mt-6 max-w-2xl text-lead text-muted" style="--i:1">{lead}</p>
    </div>
  </section>

  <section class="shell pb-20 sm:pb-28" aria-label="All integrations" data-directory>
    <div class="flex flex-col gap-4 border-b border-line pb-6 lg:flex-row lg:items-center lg:justify-between">
      <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by category" data-filters hidden>
        {
          filters.map((filter, index) => (
            <button type="button" class="filter" aria-pressed={index === 0 ? "true" : "false"} data-filter={filter}>
              {filter}
            </button>
          ))
        }
      </div>
      <label class="flex h-11 w-full items-center gap-2.5 rounded-lg bg-surface px-3.5 shadow-[inset_0_0_0_1px_var(--line-strong)] focus-within:shadow-[inset_0_0_0_1.5px_var(--ink),0_0_0_4px_var(--tide)] lg:max-w-xs" data-search hidden>
        <Icon name="search" class="size-4 text-muted" />
        <span class="sr-only">Search integrations</span>
        <input type="search" placeholder="Search integrations" class="min-w-0 flex-1 bg-transparent outline-none placeholder:text-muted" data-search-input />
      </label>
    </div>

    <p class="sr-only" aria-live="polite" data-count></p>

    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        integrations.map((item) => (
          <li class="card flex gap-4 p-5" data-item data-category={item.category} data-name={item.name.toLowerCase()}>
            <AppIcon name={item.icon} class="size-12" />
            <div class="min-w-0">
              <h2 class="font-medium">{item.name}</h2>
              <p class="text-sm text-muted">{item.category}</p>
              <p class="mt-3 text-[0.9375rem]">{item.description}</p>
            </div>
          </li>
        ))
      }
      <li class="flex flex-col justify-between gap-6 rounded-2xl bg-wash p-5" data-always>
        <div>
          <span class="grid size-12 place-items-center rounded-[28%] bg-ink text-mint">
            <Icon name="webhook" class="size-5" stroke={2} />
          </span>
          <h2 class="mt-4 font-medium">{request.title}</h2>
          <p class="mt-1 text-[0.9375rem] text-muted">{request.body}</p>
        </div>
        <a href={request.cta.href} class="arrow-link group text-[0.9375rem]">
          {request.cta.label}
          <Icon name="arrow-right" class="btn-arrow" stroke={2} />
        </a>
      </li>
    </ul>
    <p class="mt-10 text-center text-muted" data-empty hidden>No integrations match that search.</p>
  </section>

  <Closing />
</BaseLayout>

<style>
  .filter {
    padding: 0.45rem 0.85rem;
    border-radius: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--muted);
    box-shadow: inset 0 0 0 1px var(--line);
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .filter:hover {
    color: var(--ink);
  }

  .filter[aria-pressed="true"] {
    background: var(--ink);
    color: var(--page);
    box-shadow: none;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-directory]");

  if (root) {
    const filterGroup = root.querySelector<HTMLElement>("[data-filters]");
    const search = root.querySelector<HTMLElement>("[data-search]");
    const input = root.querySelector<HTMLInputElement>("[data-search-input]");
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-filter]")];
    const items = [...root.querySelectorAll<HTMLElement>("[data-item]")];
    const empty = root.querySelector<HTMLElement>("[data-empty]");
    const count = root.querySelector<HTMLElement>("[data-count]");
    let category = "All";

    /* The controls only work with JavaScript, so they stay hidden without it. */
    filterGroup?.removeAttribute("hidden");
    search?.removeAttribute("hidden");

    const update = () => {
      const query = (input?.value ?? "").trim().toLowerCase();
      let shown = 0;
      items.forEach((item) => {
        const match =
          (category === "All" || item.dataset.category === category) && (!query || (item.dataset.name ?? "").includes(query));
        item.hidden = !match;
        if (match) shown++;
      });
      if (empty) empty.hidden = shown > 0;
      if (count) count.textContent = `${shown} integration${shown === 1 ? "" : "s"} shown`;
    };

    buttons.forEach((button) =>
      button.addEventListener("click", () => {
        category = button.dataset.filter ?? "All";
        buttons.forEach((other) => other.setAttribute("aria-pressed", String(other === button)));
        update();
      }),
    );
    input?.addEventListener("input", update);
  }
</script>
